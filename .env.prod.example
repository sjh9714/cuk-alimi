# 운영 .env. 서버에서 cp .env.prod.example .env 한 뒤 채운다. 저장소에 올리지 않는다.
SITE_ADDRESS=cuk-alimi.duckdns.org
POSTGRES_PASSWORD=change-me-long-random
ADMIN_EMAIL=you@example.com

# 메모리 1GB 서버(E2.1.Micro)일 때만 주석을 푼다. A1(12GB)은 기본값으로 충분하다.
# JAVA_TOOL_OPTIONS=-Xmx256m -XX:MaxMetaspaceSize=128m -Xss512k -XX:+UseSerialGC -Duser.timezone=Asia/Seoul

# 메일. 학생이 로그인하려면 smtp여야 한다(console은 링크를 docker logs에만 찍는다). Gmail 앱 비밀번호를 SMTP_PASSWORD에.
MAIL_MODE=smtp
MAIL_FROM=
SMTP_USER=
SMTP_PASSWORD=

# AI 받아 적기와 대상 읽기. 비우면 둘 다 꺼지고 형광펜은 정규식으로 돈다. 학교 robots.txt 답이 오기 전에는 비워 둔다(docs/robots-inquiry.md).
ANTHROPIC_API_KEY=
TRANSCRIBE_DAILY_LIMIT=40
AUDIENCE_READ_DAILY_LIMIT=60

# 웹 푸시. 실제 기기에서 한 번 받아 본 뒤에 채운다. 키는 VAPID_GEN=1 ./gradlew test --tests '*VapidKeyRun' 로 한 번 만들고,
# 잃으면 모든 구독이 끊기니 백업(deploy/backup.sh)과 같은 곳에 보관한다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
